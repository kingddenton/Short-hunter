
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#0b0e11">
<title>Short Hunter</title>
<style>
:root {
  color-scheme: dark;
  --bg: #0b0e11;
  --panel: #161a1e;
  --border: #30363d;
  --yellow: #f0b90b;
  --green: #22c55e;
  --red: #ef4444;
  --text: #eaecef;
  --muted: #929aa5;
}
* { box-sizing: border-box; }
body {
  margin: 0; background: var(--bg); color: var(--text);
  font: 14px Arial, sans-serif;
}
header { padding: 18px; border-bottom: 1px solid var(--border); }
h1 { margin: 0 0 6px; color: var(--yellow); font-size: 25px; }
.subtitle { color: var(--muted); }
main { padding: 14px; max-width: 1500px; margin: auto; }
.toolbar { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
button {
  background: var(--yellow); color: #111; border: 0; border-radius: 5px;
  padding: 10px 14px; font-weight: bold; cursor: pointer;
}
button.secondary { background: #30363d; color: var(--text); }
.status {
  background: var(--panel); border: 1px solid var(--border);
  border-radius: 8px; padding: 12px; margin-bottom: 14px;
  overflow-wrap: anywhere;
}
.stats { display: flex; gap: 18px; flex-wrap: wrap; margin-top: 8px; }
.stats span { color: var(--muted); }
.stats strong { color: var(--text); }
.section {
  border: 1px solid var(--border); border-radius: 8px;
  overflow: hidden; margin-bottom: 18px;
}
.section h2 { margin: 0; padding: 13px; font-size: 17px; }
.bull h2 { color: var(--green); background: #10261a; }
.bear h2 { color: var(--red); background: #301515; }
.tablewrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; white-space: nowrap; }
th, td {
  padding: 10px; border-bottom: 1px solid var(--border);
  text-align: right;
}
th { color: var(--muted); font-weight: 600; background: var(--panel); }
th:first-child, td:first-child { text-align: left; }
tr:last-child td { border-bottom: 0; }
.green { color: var(--green); }
.red { color: var(--red); }
.muted { color: var(--muted); }
.small { font-size: 12px; line-height: 1.5; }
#log { white-space: pre-wrap; }
</style>
</head>
<body>
<header>
  <h1>🎯 Short Hunter</h1>
  <div class="subtitle">Binance USDⓈ-M Futures · Live bullish & bearish scanner</div>
</header>

<main>
  <div class="toolbar">
    <button id="startBtn">Start Scanner</button>
    <button id="stopBtn" class="secondary">Stop Scanner</button>
    <button id="notifyBtn" class="secondary">Enable Notifications</button>
  </div>

  <div class="status">
    <div id="statusText">Ready to start.</div>
    <div class="stats">
      <div><span>USDT pairs: </span><strong id="pairCount">—</strong></div>
      <div><span>Loaded: </span><strong id="loadedCount">0</strong></div>
      <div><span>Bullish: </span><strong id="bullCount">0</strong></div>
      <div><span>Bearish: </span><strong id="bearCount">0</strong></div>
    </div>
    <p id="log" class="small muted">Waiting to start.</p>
  </div>

  <section class="section bull">
    <h2>▲ Bullish Hunter — LONG</h2>
    <div class="small" style="padding:0 13px 12px">
      Daily RSI &gt; 60 · 15m Supertrend green · 15m RSI &gt; 58
    </div>
    <div class="tablewrap">
      <table>
        <thead><tr>
          <th>Token</th><th>Price</th><th>24h Change</th>
          <th>Daily RSI</th><th>15m RSI</th><th>Supertrend</th>
        </tr></thead>
        <tbody id="bullRows"><tr><td colspan="6" class="muted">No matches yet.</td></tr></tbody>
      </table>
    </div>
  </section>

  <section class="section bear">
    <h2>▼ Bearish Hunter — SHORT</h2>
    <div class="small" style="padding:0 13px 12px">
      Daily RSI &gt; 80 · 15m Supertrend red · 15m RSI &gt; 50
    </div>
    <div class="tablewrap">
      <table>
        <thead><tr>
          <th>Token</th><th>Price</th><th>24h Change</th>
          <th>Daily RSI</th><th>15m RSI</th><th>Supertrend</th>
        </tr></thead>
        <tbody id="bearRows"><tr><td colspan="6" class="muted">No matches yet.</td></tr></tbody>
      </table>
    </div>
  </section>

  <p class="small muted">
    Indicators use the current, forming candle. Signals can change before
    candle close. Public market data only; this app does not place trades.
  </p>
</main>

<script>
"use strict";

const API = "https://fapi.binance.com";
const WS = "wss://fstream.binance.com/stream?streams=";
const RSI_PERIOD = 14;
const ATR_PERIOD = 10;
const ST_MULTIPLIER = 3;
const REFRESH_MS = 30000;
const HISTORY_LIMIT = 100;

const market = new Map();
let sockets = [];
let running = false;
let refreshTimer = null;
let tickerTimer = null;
let lastAlerted = new Set();
let audioContext = null;
let tickerData = new Map();

const $ = id => document.getElementById(id);

function status(message) {
  $("statusText").textContent = message;
}

function log(message) {
  $("log").textContent = message;
}

async function fetchJSON(url, retries = 3) {
  for (let attempt = 0; attempt < retries; attempt++) {
    try {
      const response = await fetch(url);
      if (response.status === 429 || response.status === 418) {
        const wait = Math.min(30000, 3000 * (attempt + 1));
        log("Binance rate limit detected. Waiting " + (wait / 1000) + " seconds.");
        await new Promise(resolve => setTimeout(resolve, wait));
        continue;
      }
      if (!response.ok) throw new Error("HTTP " + response.status);
      return await response.json();
    } catch (error) {
      if (attempt === retries - 1) throw error;
      await new Promise(resolve => setTimeout(resolve, 1200 * (attempt + 1)));
    }
  }
  throw new Error("Request failed after retries");
}

function parseKlines(rows) {
  return rows.map(k => ({
    time: Number(k[0]),
    open: Number(k[1]),
    high: Number(k[2]),
    low: Number(k[3]),
    close: Number(k[4])
  }));
}

async function loadHistory(symbol, interval) {
  const url = API + "/fapi/v1/klines?symbol=" + symbol +
    "&interval=" + interval + "&limit=" + HISTORY_LIMIT;
  return parseKlines(await fetchJSON(url));
}

function updateCandle(symbol, interval, raw) {
  const state = market.get(symbol);
  if (!state) return;

  const candle = {
    time: Number(raw.t),
    open: Number(raw.o),
    high: Number(raw.h),
    low: Number(raw.l),
    close: Number(raw.c)
  };

  const key = interval === "1d" ? "daily" : "m15";
  const candles = state[key];
  if (!candles) return;

  const last = candles[candles.length - 1];
  if (last && last.time === candle.time) {
    candles[candles.length - 1] = candle;
  } else if (!last || candle.time > last.time) {
    candles.push(candle);
    while (candles.length > HISTORY_LIMIT) candles.shift();
  }
}

function calculateRSI(candles, period = RSI_PERIOD) {
  if (!candles || candles.length < period + 1) return null;
  const closes = candles.map(c => c.close);

  let gain = 0, loss = 0;
  for (let i = 1; i <= period; i++) {
    const diff = closes[i] - closes[i - 1];
    gain += Math.max(0, diff);
    loss += Math.max(0, -diff);
  }

  gain /= period;
  loss /= period;

  for (let i = period + 1; i < closes.length; i++) {
    const diff = closes[i] - closes[i - 1];
    gain = (gain * (period - 1) + Math.max(0, diff)) / period;
    loss = (loss * (period - 1) + Math.max(0, -diff)) / period;
  }

  if (gain === 0 && loss === 0) return 50;
  if (loss === 0) return 100;
  if (gain === 0) return 0;
  return 100 - (100 / (1 + gain / loss));
}

function calculateSupertrend(candles) {
  if (!candles || candles.length < ATR_PERIOD + 2) return null;

  const trs = [];
  for (let i = 0; i < candles.length; i++) {
    const c = candles[i];
    const prevClose = i ? candles[i - 1].close : c.close;
    trs.push(Math.max(
      c.high - c.low,
      Math.abs(c.high - prevClose),
      Math.abs(c.low - prevClose)
    ));
  }

  const atr = Array(candles.length).fill(null);
  let seed = 0;
  for (let i = 1; i <= ATR_PERIOD; i++) seed += trs[i];
  atr[ATR_PERIOD] = seed / ATR_PERIOD;

  for (let i = ATR_PERIOD + 1; i < candles.length; i++) {
    atr[i] = (atr[i - 1] * (ATR_PERIOD - 1) + trs[i]) / ATR_PERIOD;
  }

  let upper = null, lower = null, direction = 1;
  let previousUpper = null, previousLower = null;

  for (let i = ATR_PERIOD; i < candles.length; i++) {
    if (atr[i] === null) continue;
    const c = candles[i];
    const mid = (c.high + c.low) / 2;
    const basicUpper = mid + ST_MULTIPLIER * atr[i];
    const basicLower = mid - ST_MULTIPLIER * atr[i];

    upper = previousUpper === null || basicUpper < previousUpper ||
      candles[i - 1].close > previousUpper
      ? basicUpper : previousUpper;

    lower = previousLower === null || basicLower > previousLower ||
      candles[i - 1].close < previousLower
      ? basicLower : previousLower;

    if (c.close > upper) direction = 1;
    else if (c.close < lower) direction = -1;

    previousUpper = upper;
    previousLower = lower;
  }

  return direction;
}

function getSignal(symbol) {
  const s = market.get(symbol);
  if (!s || !s.daily || !s.m15) return null;

  const dailyRSI = calculateRSI(s.daily);
  const m15RSI = calculateRSI(s.m15);
  const trend = calculateSupertrend(s.m15);
  if (dailyRSI === null || m15RSI === null || trend === null) return null;

  const ticker = tickerData.get(symbol) || {};
  return {
    symbol,
    dailyRSI,
    m15RSI,
    trend,
    price: ticker.lastPrice || String(s.m15[s.m15.length - 1].close),
    change: ticker.priceChangePercent ?? null,
    bullish: dailyRSI > 60 && trend === 1 && m15RSI > 58,
    bearish: dailyRSI > 80 && trend === -1 && m15RSI > 50
  };
}

function formatPrice(value) {
  if (value == null || value === "") return "—";
  const n = Number(value);
  if (!Number.isFinite(n)) return "—";
  return n.toLocaleString("en-US", { maximumSignificantDigits: 12 });
}

function renderTable(id, rows, direction) {
  const tbody = $(id);
  if (!rows.length) {
    tbody.innerHTML = '<tr><td colspan="6" class="muted">No current matches.</td></tr>';
    return;
  }

  tbody.innerHTML = rows.map(s => {
    const change = s.change == null ? "—" : Number(s.change).toFixed(2) + "%";
    const changeClass = s.change == null ? "muted" :
      Number(s.change) >= 0 ? "green" : "red";
    const trendClass = s.trend === 1 ? "green" : "red";
    return `<tr>
      <td><strong>${s.symbol}</strong></td>
      <td>${formatPrice(s.price)}</td>
      <td class="${changeClass}">${change}</td>
      <td>${s.dailyRSI.toFixed(2)}</td>
      <td>${s.m15RSI.toFixed(2)}</td>
      <td class="${trendClass}">${s.trend === 1 ? "GREEN" : "RED"}</td>
    </tr>`;
  }).join("");
}

function beep() {
  try {
    if (!audioContext) return;
    const oscillator = audioContext.createOscillator();
    const gain = audioContext.createGain();
    oscillator.connect(gain);
    gain.connect(audioContext.destination);
    oscillator.frequency.value = 880;
    gain.gain.value = 0.12;
    oscillator.start();
    oscillator.stop(audioContext.currentTime + 0.22);
  } catch (_) {}
}

function notifySignal(signal, direction) {
  const key = direction + ":" + signal.symbol;
  if (lastAlerted.has(key)) return;
  lastAlerted.add(key);
  beep();

  if ("Notification" in window && Notification.permission === "granted") {
    try {
      new Notification("Short Hunter — " + direction, {
        body: signal.symbol + " | Daily RSI " + signal.dailyRSI.toFixed(1) +
          " | 15m RSI " + signal.m15RSI.toFixed(1)
      });
    } catch (_) {}
  }
}

function scanAndRender() {
  const bulls = [], bears = [];
  for (const symbol of market.keys()) {
    const signal = getSignal(symbol);
    if (!signal) continue;
    if (signal.bullish) bulls.push(signal);
    if (signal.bearish) bears.push(signal);
  }

  bulls.sort((a, b) => b.dailyRSI - a.dailyRSI);
  bears.sort((a, b) => b.dailyRSI - a.dailyRSI);

  const currentKeys = new Set([
    ...bulls.map(s => "BULL:" + s.symbol),
    ...bears.map(s => "BEAR:" + s.symbol)
  ]);

  for (const s of bulls) notifySignal(s, "BULL");
  for (const s of bears) notifySignal(s, "BEAR");

  // A signal can alert again only after it stops qualifying and later returns.
  lastAlerted = new Set([...lastAlerted].filter(key => {
    const parts = key.split(":");
    return currentKeys.has(parts[0] + ":" + parts[1]);
  }));

  renderTable("bullRows", bulls, "bull");
  renderTable("bearRows", bears, "bear");
  $("bullCount").textContent = bulls.length;
  $("bearCount").textContent = bears.length;
  $("loadedCount").textContent = market.size;
}

async function refreshTickers() {
  try {
    const data = await fetchJSON(API + "/fapi/v1/ticker/24hr");
    for (const t of data) {
      tickerData.set(t.symbol, {
        lastPrice: t.lastPrice,
        priceChangePercent: Number(t.priceChangePercent)
      });
    }
  } catch (e) {
    log("24h ticker refresh failed: " + e.message);
  }
}

function closeSockets() {
  for (const socket of sockets) {
    try { socket.close(); } catch (_) {}
  }
  sockets = [];
}

function connectStreams(symbols) {
  closeSockets();
  const streams = [];
  for (const symbol of symbols) {
    const s = symbol.toLowerCase();
    streams.push(s + "@kline_1d", s + "@kline_15m");
  }

  // Split into modest stream groups to keep individual URLs manageable.
  const batchSize = 160;
  for (let i = 0; i < streams.length; i += batchSize) {
    const batch = streams.slice(i, i + batchSize);
    const socket = new WebSocket(WS + batch.join("/"));
    sockets.push(socket);

    socket.onmessage = event => {
      try {
        const msg = JSON.parse(event.data);
        const data = msg.data;
        if (!data || !data.k) return;
        const k = data.k;
        updateCandle(data.s, k.i, k);
      } catch (_) {}
    };

    socket.onopen = () => {
      log("Live candle streams connected. Signals refresh every 30 seconds.");
    };

    socket.onerror = () => {
      log("A live stream encountered an error. The connection may recover or need restarting.");
    };

    socket.onclose = () => {
      if (running) {
        setTimeout(() => {
          if (running) connectStreams(symbols);
        }, 5000);
      }
    };
  }
}

async function startScanner() {
  if (running) return;
  running = true;
  $("startBtn").disabled = true;
  status("Loading Binance USDT perpetual pairs…");
  log("Connecting to Binance public market data.");

  try {
    const info = await fetchJSON(API + "/fapi/v1/exchangeInfo");
    const symbols = info.symbols
      .filter(s => s.status === "TRADING" &&
        s.contractType === "PERPETUAL" && s.quoteAsset === "USDT")
      .map(s => s.symbol);

    $("pairCount").textContent = symbols.length;

    // Low concurrency reduces request bursts and the risk of rate limiting.
    let cursor = 0, completed = 0, failures = 0;
    const workerCount = 3;

    async function worker() {
      while (running && cursor < symbols.length) {
        const symbol = symbols[cursor++];
        try {
          const daily = await loadHistory(symbol, "1d");
          await new Promise(resolve => setTimeout(resolve, 180));
          const m15 = await loadHistory(symbol, "15m");
          market.set(symbol, { daily, m15 });
        } catch (e) {
          failures++;
        }
        completed++;
        if (completed % 10 === 0 || completed === symbols.length) {
          status("Loading history: " + completed + " / " + symbols.length);
          log("Pairs with history errors: " + failures +
            ". Initial loading is deliberately rate-limited.");
          $("loadedCount").textContent = market.size;
        }
      }
    }

    await Promise.all(Array.from({ length: workerCount }, worker));
    if (!running) return;

    await refreshTickers();
    connectStreams([...market.keys()]);
    scanAndRender();

    refreshTimer = setInterval(scanAndRender, REFRESH_MS);
    tickerTimer = setInterval(refreshTickers, REFRESH_MS);

    status("Scanner running — live candle updates enabled.");
    log("History loaded for " + market.size + " pairs. Failed pairs: " + failures +
      ". Reload or restart if Binance limits requests.");
  } catch (e) {
    status("Could not start scanner.");
    log("Error: " + e.message + ". Check your connection and try again later.");
    running = false;
    $("startBtn").disabled = false;
  }
}

function stopScanner() {
  running = false;
  closeSockets();
  clearInterval(refreshTimer);
  clearInterval(tickerTimer);
  refreshTimer = tickerTimer = null;
  $("startBtn").disabled = false;
  status("Scanner stopped.");
}

$("startBtn").addEventListener("click", startScanner);
$("stopBtn").addEventListener("click", stopScanner);

$("notifyBtn").addEventListener("click", async () => {
  if ("Notification" in window) {
    const permission = await Notification.requestPermission();
    if (permission === "granted") {
      try {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (AudioContextClass) {
          audioContext = new AudioContextClass();
          await audioContext.resume();
        }
      } catch (_) {}
      status("Notifications enabled where supported by your browser.");
    } else {
      status("Notifications were not enabled.");
    }
  } else {
    status("This browser does not support web notifications.");
  }
});
</script>
</body>
</html>
